table Positions

	column PositionID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: PositionID

		annotation SummarizationSetBy = User

	column Title
		dataType: string
		summarizeBy: none
		sourceColumn: Title

		annotation SummarizationSetBy = User

	column Level
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Level

		annotation SummarizationSetBy = User

	column TargetSpan
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: TargetSpan

		annotation SummarizationSetBy = User

	column OpenDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: OpenDate

		annotation SummarizationSetBy = User

	partition Positions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Positions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"PositionID", Int64.Type}, {"Title", type text}, {"Level", Int64.Type}, {"TargetSpan", Int64.Type}, {"OpenDate", type date}}, "en-US")
				in
				    Typed

