            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.json\",\n  \"description\": \"Share of members vs share of sales per loyalty tier. Clicking a bar cross-filters the page (Deneb simple selection mode); unselected tiers fade via __selected__.\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"width\": 430,\n  \"height\": 290,\n  \"transform\": [\n    {\n      \"filter\": \"datum.LoyaltyTier != ''None''\"\n    },\n    {\n      \"joinaggregate\": [\n        {\n          \"op\": \"sum\",\n          \"field\": \"Net Sales\",\n          \"as\": \"TotalSales\"\n        },\n        {\n          \"op\": \"sum\",\n          \"field\": \"Active Customers\",\n          \"as\": \"TotalMembers\"\n        }\n      ]\n    },\n    {\n      \"calculate\": \"datum[''Active Customers''] / datum.TotalMembers\",\n      \"as\": \"Members\"\n    },\n    {\n      \"calculate\": \"datum[''Net Sales''] / datum.TotalSales\",\n      \"as\": \"Sales\"\n    },\n    {\n      \"fold\": [\n        \"Members\",\n        \"Sales\"\n      ],\n      \"as\": [\n        \"Share of\",\n        \"Share\"\n      ]\n    }\n  ],\n  \"encoding\": {\n    \"y\": {\n      \"field\": \"LoyaltyTier\",\n      \"type\": \"nominal\",\n      \"sort\": [\n        \"Platinum\",\n        \"Gold\",\n        \"Silver\",\n        \"Bronze\"\n      ],\n      \"axis\": {\n        \"title\": null,\n        \"labelFontSize\": 15,\n        \"labelColor\": \"#1E3A5F\",\n        \"labelFontWeight\": \"bold\"\n      }\n    },\n    \"yOffset\": {\n      \"field\": \"Share of\",\n      \"sort\": [\n        \"Members\",\n        \"Sales\"\n      ]\n    },\n    \"x\": {\n      \"field\": \"Share\",\n      \"type\": \"quantitative\",\n      \"axis\": null,\n      \"scale\": {\n        \"domain\": [\n          0,\n          0.62\n        ]\n      }\n    },\n    \"opacity\": {\n      \"condition\": {\n        \"test\": \"datum.__selected__ == ''off''\",\n        \"value\": 0.25\n      },\n      \"value\": 1\n    },\n    \"tooltip\": [\n      {\n        \"field\": \"LoyaltyTier\",\n        \"title\": \"Tier\"\n      },\n      {\n        \"field\": \"Active Customers\",\n        \"title\": \"Members\",\n        \"format\": \",.0f\"\n      },\n      {\n        \"field\": \"Net Sales\",\n        \"format\": \"$,.0f\"\n      },\n      {\n        \"field\": \"Share of\"\n      },\n      {\n        \"field\": \"Share\",\n        \"format\": \".1%\"\n      }\n    ]\n  },\n  \"layer\": [\n    {\n      \"mark\": {\n        \"type\": \"bar\",\n        \"cornerRadiusEnd\": 3,\n        \"height\": {\n          \"band\": 0.9\n        },\n        \"cursor\": \"pointer\"\n      },\n      \"encoding\": {\n        \"color\": {\n          \"field\": \"Share of\",\n          \"type\": \"nominal\",\n          \"scale\": {\n            \"domain\": [\n              \"Members\",\n              \"Sales\"\n            ],\n            \"range\": [\n              \"#CBD5E1\",\n              \"#1E3A5F\"\n            ]\n          },\n          \"legend\": {\n            \"title\": null,\n            \"orient\": \"top\",\n            \"direction\": \"horizontal\",\n            \"symbolType\": \"square\",\n            \"labelExpr\": \"datum.value == ''Members'' ? ''Share of members'' : ''Share of sales''\"\n          }\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"align\": \"left\",\n        \"dx\": 6,\n        \"fontSize\": 13\n      },\n      \"encoding\": {\n        \"text\": {\n          \"field\": \"Share\",\n          \"format\": \".0%\"\n        },\n        \"color\": {\n          \"condition\": {\n            \"test\": \"datum[''Share of''] == ''Sales''\",\n            \"value\": \"#1E3A5F\"\n          },\n          \"value\": \"#6B7280\"\n        }\n      }\n    }\n  ]\n}'"
                }
              }
            },
