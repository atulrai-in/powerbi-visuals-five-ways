table Categories

	column CategoryID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: CategoryID

		annotation SummarizationSetBy = User

	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = User

	column Department
		dataType: string
		summarizeBy: none
		sourceColumn: Department

		annotation SummarizationSetBy = User

	partition Categories = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Categories.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"CategoryID", Int64.Type}, {"Category", type text}, {"Department", type text}}, "en-US")
				in
				    Typed

