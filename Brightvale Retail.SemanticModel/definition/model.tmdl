model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DataFolder","Sales","Returns","Targets","Inventory","Calendar","Products","Categories","Stores","Customers","Promotions","_Measures"]

ref table Sales
ref table Returns
ref table Targets
ref table Inventory
ref table Calendar
ref table Products
ref table Categories
ref table Stores
ref table Customers
ref table Promotions
ref table _Measures
ref table Metric
ref table Breakdown
ref table 'Store Scope'

ref cultureInfo en-US

