table Customers

	column CustomerID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: CustomerID

		annotation SummarizationSetBy = User

	column CustomerName
		dataType: string
		summarizeBy: none
		sourceColumn: CustomerName

		annotation SummarizationSetBy = User

	column Gender
		dataType: string
		summarizeBy: none
		sourceColumn: Gender

		annotation SummarizationSetBy = User

	column AgeBand
		dataType: string
		summarizeBy: none
		sourceColumn: AgeBand

		annotation SummarizationSetBy = User

	column Segment
		dataType: string
		summarizeBy: none
		sourceColumn: Segment

		annotation SummarizationSetBy = User

	column LoyaltyTier
		dataType: string
		summarizeBy: none
		sourceColumn: LoyaltyTier
		sortByColumn: LoyaltyTierOrder

		annotation SummarizationSetBy = User

	column JoinDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: JoinDate

		annotation SummarizationSetBy = User

	column HomeStoreID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: HomeStoreID

		annotation SummarizationSetBy = User

	column City
		dataType: string
		dataCategory: City
		summarizeBy: none
		sourceColumn: City

		annotation SummarizationSetBy = User

	column State
		dataType: string
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = User

	column LoyaltyTierOrder
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: LoyaltyTierOrder

		annotation SummarizationSetBy = User

	partition Customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Customers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"CustomerID", Int64.Type}, {"CustomerName", type text}, {"Gender", type text}, {"AgeBand", type text}, {"Segment", type text}, {"LoyaltyTier", type text}, {"JoinDate", type date}, {"HomeStoreID", Int64.Type}, {"City", type text}, {"State", type text}}, "en-US"),
				    Final = Table.AddColumn(Typed, "LoyaltyTierOrder", each List.PositionOf({"None","Bronze","Silver","Gold","Platinum"}, [LoyaltyTier]), Int64.Type)
				in
				    Final

