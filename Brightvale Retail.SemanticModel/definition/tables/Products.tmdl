table Products

	column ProductID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ProductID

		annotation SummarizationSetBy = User

	column ProductName
		dataType: string
		summarizeBy: none
		sourceColumn: ProductName

		annotation SummarizationSetBy = User

	column CategoryID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: CategoryID

		annotation SummarizationSetBy = User

	column Subcategory
		dataType: string
		summarizeBy: none
		sourceColumn: Subcategory

		annotation SummarizationSetBy = User

	column Brand
		dataType: string
		summarizeBy: none
		sourceColumn: Brand

		annotation SummarizationSetBy = User

	column PriceTier
		dataType: string
		summarizeBy: none
		sourceColumn: PriceTier
		sortByColumn: PriceTierOrder

		annotation SummarizationSetBy = User

	column ListPrice
		dataType: decimal
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: ListPrice

		annotation SummarizationSetBy = User

	column UnitCost
		dataType: decimal
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: UnitCost

		annotation SummarizationSetBy = User

	column LaunchDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: LaunchDate

		annotation SummarizationSetBy = User

	column PriceTierOrder
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: PriceTierOrder

		annotation SummarizationSetBy = User

	partition Products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Products.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"ProductID", Int64.Type}, {"ProductName", type text}, {"CategoryID", Int64.Type}, {"Subcategory", type text}, {"Brand", type text}, {"PriceTier", type text}, {"ListPrice", Currency.Type}, {"UnitCost", Currency.Type}, {"LaunchDate", type date}}, "en-US"),
				    Final = Table.AddColumn(Typed, "PriceTierOrder", each List.PositionOf({"Good","Better","Best"}, [PriceTier]), Int64.Type)
				in
				    Final

