table Sales

	column OrderLineID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: OrderLineID

		annotation SummarizationSetBy = User

	column OrderID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: OrderID

		annotation SummarizationSetBy = User

	column OrderDate
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: OrderDate

		annotation SummarizationSetBy = User

	column OrderHour
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: OrderHour

		annotation SummarizationSetBy = User

	column StoreID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: StoreID

		annotation SummarizationSetBy = User

	column Channel
		dataType: string
		summarizeBy: none
		sourceColumn: Channel

		annotation SummarizationSetBy = User

	column CustomerID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: CustomerID

		annotation SummarizationSetBy = User

	column ProductID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ProductID

		annotation SummarizationSetBy = User

	column PromotionID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: PromotionID

		annotation SummarizationSetBy = User

	column Quantity
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: Quantity

		annotation SummarizationSetBy = User

	column UnitPrice
		dataType: decimal
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: UnitPrice

		annotation SummarizationSetBy = User

	column DiscountPct
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: DiscountPct

		annotation SummarizationSetBy = User

	column NetSales
		dataType: decimal
		formatString: $#,0.00
		summarizeBy: sum
		sourceColumn: NetSales

		annotation SummarizationSetBy = User

	column CostAmount
		dataType: decimal
		formatString: $#,0.00
		summarizeBy: sum
		sourceColumn: CostAmount

		annotation SummarizationSetBy = User

	partition Sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Sales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"OrderLineID", Int64.Type}, {"OrderID", Int64.Type}, {"OrderDate", type date}, {"OrderHour", Int64.Type}, {"StoreID", Int64.Type}, {"Channel", type text}, {"CustomerID", Int64.Type}, {"ProductID", Int64.Type}, {"PromotionID", Int64.Type}, {"Quantity", Int64.Type}, {"UnitPrice", Currency.Type}, {"DiscountPct", type number}, {"NetSales", Currency.Type}, {"CostAmount", Currency.Type}}, "en-US")
				in
				    Typed

