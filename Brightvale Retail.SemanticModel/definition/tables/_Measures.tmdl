table _Measures

	measure 'Net Sales' = SUM(Sales[NetSales])
		formatString: $#,0
		displayFolder: Sales

	measure 'Gross Sales' = SUMX(Sales, Sales[Quantity] * Sales[UnitPrice])
		formatString: $#,0
		displayFolder: Sales

	measure 'Discount Amount' = [Gross Sales] - [Net Sales]
		formatString: $#,0
		displayFolder: Sales

	measure 'Discount %' = DIVIDE([Discount Amount], [Gross Sales])
		formatString: 0.0%
		displayFolder: Sales

	measure Units = SUM(Sales[Quantity])
		formatString: #,0
		displayFolder: Sales

	measure Orders = DISTINCTCOUNT(Sales[OrderID])
		formatString: #,0
		displayFolder: Sales

	measure 'Avg Order Value' = DIVIDE([Net Sales], [Orders])
		formatString: $#,0.00
		displayFolder: Sales

	measure 'Active Customers' = CALCULATE(DISTINCTCOUNT(Sales[CustomerID]), Sales[CustomerID] <> 0)
		formatString: #,0
		displayFolder: Sales

	measure 'Online Share %' = DIVIDE(CALCULATE([Net Sales], Sales[Channel] = "Online"), [Net Sales])
		formatString: 0.0%
		displayFolder: Sales

	measure 'Promo Share %' = DIVIDE(CALCULATE([Net Sales], Sales[PromotionID] <> 0), [Net Sales])
		formatString: 0.0%
		displayFolder: Sales

	measure Cost = SUM(Sales[CostAmount])
		formatString: $#,0
		displayFolder: Margin

	measure Margin = [Net Sales] - [Cost]
		formatString: $#,0
		displayFolder: Margin

	measure 'Margin %' = DIVIDE([Margin], [Net Sales])
		formatString: 0.0%
		displayFolder: Margin

	measure 'Net Sales PY' = ```
			-- prior year, limited to dates that have actuals this year (fair YTD comparison)
			CALCULATE(
			    [Net Sales],
			    CALCULATETABLE(SAMEPERIODLASTYEAR('Calendar'[Date]), 'Calendar'[HasActuals] = 1)
			)
			```
		formatString: $#,0
		displayFolder: Time Intelligence

	measure 'YoY Change' = VAR _py = [Net Sales PY] RETURN IF(NOT ISBLANK(_py), [Net Sales] - _py)
		formatString: $#,0
		displayFolder: Time Intelligence

	measure 'YoY %' = DIVIDE([YoY Change], [Net Sales PY])
		formatString: 0.0%
		displayFolder: Time Intelligence

	measure 'Net Sales YTD' = TOTALYTD([Net Sales], 'Calendar'[Date])
		formatString: $#,0
		displayFolder: Time Intelligence

	measure 'Margin % PY' = CALCULATE([Margin %], CALCULATETABLE(SAMEPERIODLASTYEAR('Calendar'[Date]), 'Calendar'[HasActuals] = 1))
		formatString: 0.0%
		displayFolder: Time Intelligence

	measure 'LFL Net Sales' = ```
			-- stores open at least 12 months before the start of the selected period
			VAR _cutoff = EDATE(MIN('Calendar'[Date]), -12)
			RETURN CALCULATE([Net Sales], KEEPFILTERS(Stores[OpenDate] <= _cutoff))
			```
		formatString: $#,0
		displayFolder: Like for Like

	measure 'LFL Net Sales PY' = ```
			VAR _cutoff = EDATE(MIN('Calendar'[Date]), -12)
			RETURN CALCULATE([Net Sales PY], KEEPFILTERS(Stores[OpenDate] <= _cutoff))
			```
		formatString: $#,0
		displayFolder: Like for Like

	measure 'LFL YoY %' = DIVIDE([LFL Net Sales] - [LFL Net Sales PY], [LFL Net Sales PY])
		formatString: 0.0%
		displayFolder: Like for Like

	measure Target = SUM(Targets[TargetSales])
		formatString: $#,0
		displayFolder: Target

	measure 'Target to Date' = CALCULATE([Target], KEEPFILTERS('Calendar'[HasActuals] = 1))
		formatString: $#,0
		displayFolder: Target

	measure 'Variance to Target' = VAR _t = [Target to Date] RETURN IF(NOT ISBLANK(_t), [Net Sales] - _t)
		formatString: $#,0
		displayFolder: Target

	measure 'Variance to Target %' = DIVIDE([Variance to Target], [Target to Date])
		formatString: 0.0%
		displayFolder: Target

	measure 'Refund Amount' = SUM(Returns[RefundAmount])
		formatString: $#,0
		displayFolder: Returns

	measure 'Return Lines' = COUNTROWS(Returns)
		formatString: #,0
		displayFolder: Returns

	measure 'Return Rate %' = ```
			-- returned lines / sold lines
			DIVIDE([Return Lines], COUNTROWS(Sales))
			```
		formatString: 0.0%
		displayFolder: Returns

	measure 'Refund % of Sales' = DIVIDE([Refund Amount], [Net Sales])
		formatString: 0.0%
		displayFolder: Returns

	measure 'On Hand Units' = ```
			-- semi-additive: last month-end snapshot in the period
			VAR _last = CALCULATE(MAX(Inventory[SnapshotDate]))
			RETURN CALCULATE(SUM(Inventory[OnHandUnits]), 'Calendar'[Date] = _last)
			```
		formatString: #,0
		displayFolder: Inventory

	measure 'On Hand Cost' = ```
			VAR _last = CALCULATE(MAX(Inventory[SnapshotDate]))
			RETURN CALCULATE(SUM(Inventory[OnHandCost]), 'Calendar'[Date] = _last)
			```
		formatString: $#,0
		displayFolder: Inventory

	measure 'Avg Weeks of Cover' = ```
			VAR _last = CALCULATE(MAX(Inventory[SnapshotDate]))
			RETURN CALCULATE(AVERAGE(Inventory[WeeksOfCover]), 'Calendar'[Date] = _last)
			```
		formatString: 0.0
		displayFolder: Inventory

	measure 'Avg Stockout Days' = AVERAGE(Inventory[StockoutDays])
		formatString: 0.0
		displayFolder: Inventory

	measure 'Title Trend' = ```
			VAR _region = IF(HASONEVALUE(Stores[Region]), VALUES(Stores[Region]), "All regions")
			RETURN _region & ": total sales " & FORMAT([YoY %], "+0.0%;-0.0%") & " YoY, like-for-like stores " & FORMAT([LFL YoY %], "+0.0%;-0.0%")
			```
		displayFolder: Post 1

	measure 'Selected Metric' = SWITCH(SELECTEDVALUE(Metric[Metric Order]), 0, "Net Sales", 1, "YoY %", 2, "LFL YoY %", 3, "Variance to Target %", 4, "Margin %", "Metric")
		displayFolder: Post 1

	measure 'Selected Breakdown' = SWITCH(SELECTEDVALUE(Breakdown[Breakdown Order]), 0, "Region", 1, "Store", 2, "Format", 3, "Category", "breakdown")
		displayFolder: Post 1

	measure 'Title Breakdown' = [Selected Metric] & " by " & LOWER([Selected Breakdown])
		displayFolder: Post 1

	measure 'Title Matrix' = [Selected Metric] & ": all stores vs like-for-like vs new stores"
		displayFolder: Post 1

	measure 'Metric Color' = ```
			-- bars: neutral for absolute metrics, red/green for growth and variance metrics
			VAR _order = SELECTEDVALUE(Metric[Metric Order], 0)
			VAR _v = SWITCH(_order, 1, [YoY %], 2, [LFL YoY %], 3, [Variance to Target %])
			RETURN IF(_order IN {0, 4}, "#1E3A5F", IF(_v < 0, "#C2410C", "#15803D"))
			```
		displayFolder: Post 1

	measure 'Color YoY' = IF([YoY %] < 0, "#C2410C", "#15803D")
		displayFolder: Post 1

	measure 'Color LFL' = IF([LFL YoY %] < 0, "#C2410C", "#15803D")
		displayFolder: Post 1

	measure 'Color Var' = IF([Variance to Target %] < 0, "#C2410C", "#15803D")
		displayFolder: Post 1

	measure 'SVG Sparkline' = ```
			-- rolling 12-month net sales at each month end since Jan 2025 (removes the Black Friday spike so the trend shows)
			-- months with no sales yet are skipped, so new stores start partway along
			VAR _w = 200
			VAR _h = 28
			VAR _pad = 3
			VAR _n = 22 -- Jan 2025 .. Oct 2026
			VAR _months =
			    CALCULATETABLE (
			        VALUES ( 'Calendar'[YearMonth] ),
			        REMOVEFILTERS ( 'Calendar' ),
			        'Calendar'[Date] >= DATE ( 2025, 1, 1 ),
			        'Calendar'[HasActuals] = 1
			    )
			VAR _t =
			    ADDCOLUMNS (
			        _months,
			        "@i", ( INT ( 'Calendar'[YearMonth] / 100 ) - 2025 ) * 12 + MOD ( 'Calendar'[YearMonth], 100 ),
			        "@v",
			            VAR _ym = 'Calendar'[YearMonth]
			            RETURN
			                CALCULATE (
			                    [Net Sales],
			                    REMOVEFILTERS ( 'Calendar' ),
			                    'Calendar'[YearMonth] > _ym - 100,
			                    'Calendar'[YearMonth] <= _ym
			                )
			    )
			VAR _pts = FILTER ( _t, NOT ISBLANK ( [@v] ) )
			VAR _min = MINX ( _pts, [@v] )
			VAR _max = MAXX ( _pts, [@v] )
			VAR _range = IF ( _max = _min, 1, _max - _min )
			VAR _xy =
			    ADDCOLUMNS (
			        _pts,
			        "@x", _pad + ( [@i] - 1 ) / ( _n - 1 ) * ( _w - 2 * _pad ),
			        "@y", _pad + ( 1 - ( [@v] - _min ) / _range ) * ( _h - 2 * _pad )
			    )
			VAR _poly = CONCATENATEX ( _xy, FORMAT ( [@x], "0.0" ) & "," & FORMAT ( [@y], "0.0" ), " ", [@i], ASC )
			VAR _last = TOPN ( 1, _xy, [@i], DESC )
			VAR _lx = FORMAT ( MAXX ( _last, [@x] ), "0.0" )
			VAR _ly = FORMAT ( MAXX ( _last, [@y] ), "0.0" )
			VAR _col = IF ( [YoY %] < 0, "%23C2410C", "%2315803D" )
			RETURN
			    IF (
			        COUNTROWS ( _pts ) > 1,
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 28' width='200' height='28'>"
			            & "<polyline points='" & _poly & "' fill='none' stroke='" & _col & "' stroke-width='1.8' stroke-linejoin='round' stroke-linecap='round'/>"
			            & "<circle cx='" & _lx & "' cy='" & _ly & "' r='2.8' fill='" & _col & "'/></svg>"
			    )
			```
		dataCategory: ImageUrl
		displayFolder: Post 2

	measure 'SVG Bullet' = ```
			-- bullet chart: bar = actual, tick = target to date, grey bands = 0-90% and 90-130% of target
			VAR _a = [Net Sales]
			VAR _tgt = [Target to Date]
			VAR _pct = DIVIDE ( _a, _tgt )
			VAR _scale = 1.3
			VAR _bw = 138
			VAR _bar = FORMAT ( MIN ( _pct, _scale ) / _scale * _bw, "0.0" )
			VAR _tx = FORMAT ( 1 / _scale * _bw, "0.0" )
			VAR _band = FORMAT ( 0.9 / _scale * _bw, "0.0" )
			VAR _col = SWITCH ( TRUE (), _pct >= 1, "%2315803D", _pct >= 0.95, "%23B45309", "%23C2410C" )
			RETURN
			    IF (
			        NOT ISBLANK ( _tgt ) && NOT ISBLANK ( _a ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 28' width='200' height='28'>"
			            & "<rect x='0' y='5' width='" & _bw & "' height='18' fill='%23F1F5F9'/>"
			            & "<rect x='0' y='5' width='" & _band & "' height='18' fill='%23E2E8F0'/>"
			            & "<rect x='0' y='10' width='" & _bar & "' height='8' rx='1' fill='" & _col & "'/>"
			            & "<line x1='" & _tx & "' x2='" & _tx & "' y1='3' y2='25' stroke='%231E3A5F' stroke-width='2'/>"
			            & "<text x='144' y='20' font-family='Segoe UI' font-size='17' font-weight='600' fill='%231F2937'>" & FORMAT ( _pct * 100, "0" ) & "%25</text></svg>"
			    )
			```
		dataCategory: ImageUrl
		displayFolder: Post 2

	measure 'Store Status' = ```
			VAR _cutoff = EDATE ( MIN ( 'Calendar'[Date] ), -12 )
			VAR _open = MIN ( Stores[OpenDate] )
			VAR _yoy = [YoY %]
			RETURN
			    IF (
			        HASONEVALUE ( Stores[StoreID] ) && NOT ISBLANK ( [Net Sales] ),
			        SWITCH (
			            TRUE (),
			            _open > _cutoff, "Ramping",
			            _yoy >= 0.03, "Growing",
			            _yoy <= -0.10, "Declining",
			            _yoy < -0.03, "Slipping",
			            "Steady"
			        )
			    )
			```
		displayFolder: Post 2

	measure 'SVG Status' = ```
			VAR _s = [Store Status]
			VAR _bg = SWITCH ( _s, "Ramping", "%23DBEAFE", "Growing", "%23DCFCE7", "Declining", "%23FEE2E2", "Slipping", "%23FFEDD5", "%23F1F5F9" )
			VAR _fg = SWITCH ( _s, "Ramping", "%231D4ED8", "Growing", "%2315803D", "Declining", "%23B91C1C", "Slipping", "%23C2410C", "%23475569" )
			RETURN
			    IF (
			        NOT ISBLANK ( _s ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 28' width='200' height='28'>"
			            & "<rect x='20' y='1' width='160' height='26' rx='13' fill='" & _bg & "'/>"
			            & "<text x='100' y='20' text-anchor='middle' font-family='Segoe UI' font-size='17' font-weight='700' fill='" & _fg & "'>" & _s & "</text></svg>"
			    )
			```
		dataCategory: ImageUrl
		displayFolder: Post 2

	measure 'Title Scorecard' = ```
			VAR _declining = COUNTROWS ( FILTER ( VALUES ( Stores[StoreID] ), [Store Status] = "Declining" ) )
			VAR _ramping = COUNTROWS ( FILTER ( VALUES ( Stores[StoreID] ), [Store Status] = "Ramping" ) )
			RETURN
			    "Store scorecard " & SELECTEDVALUE ( 'Calendar'[Year] ) & " YTD · " & _declining & " stores declining · "
			        & _ramping & " new stores ramping"
			```
		displayFolder: Post 2

	measure 'Promo Window Sales' = ```
			-- net sales of the promoted categories and channels, from 6 weeks before to 8 weeks after the promotion
			-- (ignores the promotion filter itself, so non-promo sales of those categories count too)
			VAR _s = SELECTEDVALUE ( Promotions[StartDate] )
			VAR _e = SELECTEDVALUE ( Promotions[EndDate] )
			VAR _cats = SELECTEDVALUE ( Promotions[Categories] )
			VAR _ch = SELECTEDVALUE ( Promotions[Channels] )
			VAR _d = MAX ( 'Calendar'[Date] )
			RETURN
			    IF (
			        NOT ISBLANK ( _s ) && _cats <> "" && HASONEVALUE ( 'Calendar'[Date] )
			            && _d >= _s - 42 && _d <= _e + 56 && MAX ( 'Calendar'[HasActuals] ) = 1,
			        CALCULATE (
			            [Net Sales],
			            REMOVEFILTERS ( Promotions ),
			            KEEPFILTERS ( FILTER ( ALL ( Categories[Category] ), CONTAINSSTRING ( _cats, Categories[Category] ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( Sales[Channel] ), CONTAINSSTRING ( _ch, Sales[Channel] ) ) )
			        ) + 0
			    )
			```
		formatString: $#,0
		displayFolder: Post 4

	measure 'Promo Window Sales LY' = ```
			-- same categories and channels, same weekday 52 weeks earlier: the baseline that removes seasonality
			VAR _s = SELECTEDVALUE ( Promotions[StartDate] )
			VAR _e = SELECTEDVALUE ( Promotions[EndDate] )
			VAR _cats = SELECTEDVALUE ( Promotions[Categories] )
			VAR _ch = SELECTEDVALUE ( Promotions[Channels] )
			VAR _d = MAX ( 'Calendar'[Date] )
			RETURN
			    IF (
			        NOT ISBLANK ( [Promo Window Sales] ),
			        CALCULATE (
			            [Net Sales],
			            REMOVEFILTERS ( Promotions ),
			            REMOVEFILTERS ( 'Calendar' ),
			            'Calendar'[Date] = _d - 364,
			            KEEPFILTERS ( FILTER ( ALL ( Categories[Category] ), CONTAINSSTRING ( _cats, Categories[Category] ) ) ),
			            KEEPFILTERS ( FILTER ( ALL ( Sales[Channel] ), CONTAINSSTRING ( _ch, Sales[Channel] ) ) )
			        ) + 0
			    )
			```
		formatString: $#,0
		displayFolder: Post 4

	measure 'Promo Phase' = ```
			VAR _s = SELECTEDVALUE ( Promotions[StartDate] )
			VAR _e = SELECTEDVALUE ( Promotions[EndDate] )
			VAR _cats = SELECTEDVALUE ( Promotions[Categories] )
			VAR _ch = SELECTEDVALUE ( Promotions[Channels] )
			VAR _d = MAX ( 'Calendar'[Date] )
			RETURN
			    IF (
			        NOT ISBLANK ( [Promo Window Sales] ),
			        SWITCH ( TRUE (), _d < _s, "Before", _d <= _e, "During", _d <= _e + 28, "Next 4 weeks", "Weeks 5-8" )
			    )
			```
		displayFolder: Post 4

	measure 'Title Promo' = ```
			-- Percentages live in the chart's bands: a click cross-filter from another visual
			-- does not reach a visual's dynamic title (slicer filters do), so the title would go stale.
			VAR _name = SELECTEDVALUE ( Promotions[PromotionName] )
			VAR _s = SELECTEDVALUE ( Promotions[StartDate] )
			VAR _e = SELECTEDVALUE ( Promotions[EndDate] )
			VAR _cats = SELECTEDVALUE ( Promotions[Categories] )
			RETURN
			    IF (
			        ISBLANK ( _name ),
			        "Pick one promotion",
			        _name & " · " & FORMAT ( _s, IF ( YEAR ( _s ) <> YEAR ( _e ), "d mmm yyyy", "d mmm" ) ) & " – " & FORMAT ( _e, "d mmm yyyy" )
			            & " · daily "
			            & IF ( LEN ( _cats ) > 60, "sales (all categories)", SUBSTITUTE ( _cats, "; ", ", " ) & " sales" )
			            & " vs the same weekdays last year"
			    )
			```
		displayFolder: Post 4

	measure 'As Of Date' = MAX ( 'As Of'[As Of Date] )
		formatString: d mmm yyyy
		displayFolder: People

	measure 'As Of Label' = "as at " & FORMAT ( [As Of Date], "d mmm yyyy" )
		displayFolder: People

	measure 'Planned FTE' = ```
			-- every live seat, filled or open
			VAR _d = [As Of Date]
			VAR _live = FILTER ( OrgTimeline, OrgTimeline[ValidFrom] <= _d && ( ISBLANK ( OrgTimeline[ValidTo] ) || OrgTimeline[ValidTo] >= _d ) )
			RETURN SUMX ( _live, OrgTimeline[FTE] )
			```
		formatString: #,0.0
		displayFolder: People

	measure 'Effective FTE' = ```
			-- seats with someone in them who is not on leave
			VAR _d = [As Of Date]
			VAR _live = FILTER ( OrgTimeline, OrgTimeline[ValidFrom] <= _d && ( ISBLANK ( OrgTimeline[ValidTo] ) || OrgTimeline[ValidTo] >= _d ) )
			RETURN SUMX ( FILTER ( _live, OrgTimeline[Status] = "Filled" ), OrgTimeline[FTE] )
			```
		formatString: #,0.0
		displayFolder: People

	measure 'Staffed %' = DIVIDE ( [Effective FTE], [Planned FTE] )
		formatString: 0%
		displayFolder: People

	measure Headcount = ```
			-- people in post, including those on leave
			VAR _d = [As Of Date]
			VAR _live = FILTER ( OrgTimeline, OrgTimeline[ValidFrom] <= _d && ( ISBLANK ( OrgTimeline[ValidTo] ) || OrgTimeline[ValidTo] >= _d ) )
			RETURN COUNTROWS ( FILTER ( _live, NOT ISBLANK ( OrgTimeline[PersonID] ) ) )
			```
		formatString: #,0
		displayFolder: People

	measure 'Open Roles' = ```
			VAR _d = [As Of Date]
			VAR _live = FILTER ( OrgTimeline, OrgTimeline[ValidFrom] <= _d && ( ISBLANK ( OrgTimeline[ValidTo] ) || OrgTimeline[ValidTo] >= _d ) )
			RETURN COUNTROWS ( FILTER ( _live, OrgTimeline[Status] = "Open" ) ) + 0
			```
		formatString: #,0
		displayFolder: People

	measure 'On Leave' = ```
			VAR _d = [As Of Date]
			VAR _live = FILTER ( OrgTimeline, OrgTimeline[ValidFrom] <= _d && ( ISBLANK ( OrgTimeline[ValidTo] ) || OrgTimeline[ValidTo] >= _d ) )
			RETURN COUNTROWS ( FILTER ( _live, OrgTimeline[Status] = "On leave" ) ) + 0
			```
		formatString: #,0
		displayFolder: People

	measure 'Staff Cost' = ```
			-- annual cost of the people in post
			VAR _d = [As Of Date]
			VAR _live = FILTER ( OrgTimeline, OrgTimeline[ValidFrom] <= _d && ( ISBLANK ( OrgTimeline[ValidTo] ) || OrgTimeline[ValidTo] >= _d ) )
			RETURN SUMX ( _live, OrgTimeline[AnnualCost] )
			```
		formatString: $#,0
		displayFolder: People

	measure Managers = ```
			-- seats that have at least one person reporting to them
			VAR _d = [As Of Date]
			VAR _live = FILTER ( OrgTimeline, OrgTimeline[ValidFrom] <= _d && ( ISBLANK ( OrgTimeline[ValidTo] ) || OrgTimeline[ValidTo] >= _d ) )
			RETURN COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( FILTER ( _live, NOT ISBLANK ( OrgTimeline[PersonID] ) && NOT ISBLANK ( OrgTimeline[ReportsToPositionID] ) ), "m", OrgTimeline[ReportsToPositionID] ) ) )
			```
		formatString: #,0
		displayFolder: People

	measure 'Avg Span' = ```
			VAR _d = [As Of Date]
			VAR _live = FILTER ( OrgTimeline, OrgTimeline[ValidFrom] <= _d && ( ISBLANK ( OrgTimeline[ValidTo] ) || OrgTimeline[ValidTo] >= _d ) )
			VAR _reports = COUNTROWS ( FILTER ( _live, NOT ISBLANK ( OrgTimeline[PersonID] ) && NOT ISBLANK ( OrgTimeline[ReportsToPositionID] ) ) )
			RETURN DIVIDE ( _reports, [Managers] )
			```
		formatString: 0.0
		displayFolder: People

	measure 'Hires 90d' = ```
			VAR _d = [As Of Date]
			RETURN
			    CALCULATE (
			        COUNTROWS ( Movements ),
			        REMOVEFILTERS ( 'Calendar' ),
			        Movements[MoveType] IN { "Hire" },
			        Movements[MoveDate] > _d - 90,
			        Movements[MoveDate] <= _d
			    ) + 0
			```
		formatString: #,0
		displayFolder: People

	measure 'Exits 12m' = ```
			VAR _d = [As Of Date]
			RETURN
			    CALCULATE (
			        COUNTROWS ( Movements ),
			        REMOVEFILTERS ( 'Calendar' ),
			        Movements[MoveType] IN { "Exit" },
			        Movements[MoveDate] > _d - 365,
			        Movements[MoveDate] <= _d
			    ) + 0
			```
		formatString: #,0
		displayFolder: People

	measure 'Internal Moves 12m' = ```
			VAR _d = [As Of Date]
			RETURN
			    CALCULATE (
			        COUNTROWS ( Movements ),
			        REMOVEFILTERS ( 'Calendar' ),
			        Movements[MoveType] IN { "Transfer", "Promotion" },
			        Movements[MoveDate] > _d - 365,
			        Movements[MoveDate] <= _d
			    ) + 0
			```
		formatString: #,0
		displayFolder: People

	measure 'Attrition % 12m' = DIVIDE ( [Exits 12m], [Headcount] )
		formatString: 0.0%
		displayFolder: People

	column Placeholder
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Placeholder

		annotation SummarizationSetBy = User

	partition _Measures = m
		mode: import
		source =
				#table(type table [Placeholder = text], {})

