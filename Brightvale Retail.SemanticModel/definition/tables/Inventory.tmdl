table Inventory

	column SnapshotDate
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: SnapshotDate

		annotation SummarizationSetBy = User

	column StoreID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: StoreID

		annotation SummarizationSetBy = User

	column CategoryID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: CategoryID

		annotation SummarizationSetBy = User

	column OnHandUnits
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: OnHandUnits

		annotation SummarizationSetBy = User

	column OnHandCost
		dataType: decimal
		formatString: $#,0.00
		summarizeBy: none
		sourceColumn: OnHandCost

		annotation SummarizationSetBy = User

	column StockoutDays
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: StockoutDays

		annotation SummarizationSetBy = User

	column WeeksOfCover
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: WeeksOfCover

		annotation SummarizationSetBy = User

	partition Inventory = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Inventory.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"SnapshotDate", type date}, {"StoreID", Int64.Type}, {"CategoryID", Int64.Type}, {"OnHandUnits", Int64.Type}, {"OnHandCost", Currency.Type}, {"StockoutDays", Int64.Type}, {"WeeksOfCover", type number}}, "en-US")
				in
				    Typed

