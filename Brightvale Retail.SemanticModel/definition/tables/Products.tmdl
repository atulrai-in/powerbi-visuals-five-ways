	partition Products = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Products.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"ProductID", Int64.Type}, {"ProductName", type text}, {"CategoryID", Int64.Type}, {"Subcategory", type text}, {"Brand", type text}, {"PriceTier", type text}, {"ListPrice", Currency.Type}, {"UnitCost", Currency.Type}, {"LaunchDate", type date}}, "en-US"),
				    Final = Table.AddColumn(Typed, "PriceTierOrder", each List.PositionOf({"Good","Better","Best"}, [PriceTier]), Int64.Type)
				in
				    Final

