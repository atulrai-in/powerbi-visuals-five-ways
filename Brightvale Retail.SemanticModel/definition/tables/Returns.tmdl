table Returns

	column ReturnID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ReturnID

		annotation SummarizationSetBy = User

	column OrderLineID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: OrderLineID

		annotation SummarizationSetBy = User

	column ReturnDate
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: ReturnDate

		annotation SummarizationSetBy = User

	column StoreID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: StoreID

		annotation SummarizationSetBy = User

	column Channel
		dataType: string
		summarizeBy: none
		sourceColumn: Channel

		annotation SummarizationSetBy = User

	column CustomerID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: CustomerID

		annotation SummarizationSetBy = User

	column ProductID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: ProductID

		annotation SummarizationSetBy = User

	column ReturnQty
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: ReturnQty

		annotation SummarizationSetBy = User

	column RefundAmount
		dataType: decimal
		formatString: $#,0.00
		summarizeBy: sum
		sourceColumn: RefundAmount

		annotation SummarizationSetBy = User

	column ReturnReason
		dataType: string
		summarizeBy: none
		sourceColumn: ReturnReason

		annotation SummarizationSetBy = User

	partition Returns = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Returns.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"ReturnID", Int64.Type}, {"OrderLineID", Int64.Type}, {"ReturnDate", type date}, {"StoreID", Int64.Type}, {"Channel", type text}, {"CustomerID", Int64.Type}, {"ProductID", Int64.Type}, {"ReturnQty", Int64.Type}, {"RefundAmount", Currency.Type}, {"ReturnReason", type text}}, "en-US")
				in
				    Typed

