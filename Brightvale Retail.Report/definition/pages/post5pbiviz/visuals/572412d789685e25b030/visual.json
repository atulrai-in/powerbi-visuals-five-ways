    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Why a custom visual, when Deneb exists?",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#1E3A5F",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It's reusable by people who don't write code.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1E3A5F",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " Five named field wells (Category, Month, Sales, Weeks of cover, Stockout days), and thresholds, colours and sort order in the Format pane. No JSON to edit.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It behaves like a native visual.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1E3A5F",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " Click a row to cross-filter the page, right-click for the usual menu, tooltips on every bar, and a landing message until the fields are filled in.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It ships as one 28 KB file.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1E3A5F",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " Import the .pbiviz into any report, or publish it to your organisation's visuals so everyone gets the same version.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#374151"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
