table Targets

	column MonthStart
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: MonthStart

		annotation SummarizationSetBy = User

	column StoreID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: StoreID

		annotation SummarizationSetBy = User

	column CategoryID
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: CategoryID

		annotation SummarizationSetBy = User

	column TargetSales
		dataType: decimal
		formatString: $#,0
		summarizeBy: sum
		sourceColumn: TargetSales

		annotation SummarizationSetBy = User

	partition Targets = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Targets.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"MonthStart", type date}, {"StoreID", Int64.Type}, {"CategoryID", Int64.Type}, {"TargetSales", Currency.Type}}, "en-US")
				in
				    Typed

