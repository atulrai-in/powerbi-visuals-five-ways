table Calendar
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = User

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Year

		annotation SummarizationSetBy = User

	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: Quarter

		annotation SummarizationSetBy = User

	column MonthNo
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: MonthNo

		annotation SummarizationSetBy = User

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: MonthNo

		annotation SummarizationSetBy = User

	column MonthShort
		dataType: string
		summarizeBy: none
		sourceColumn: MonthShort
		sortByColumn: MonthNo

		annotation SummarizationSetBy = User

	column YearMonth
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: YearMonth

		annotation SummarizationSetBy = User

	column MonthYear
		dataType: string
		summarizeBy: none
		sourceColumn: MonthYear
		sortByColumn: YearMonth

		annotation SummarizationSetBy = User

	column DayOfMonth
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DayOfMonth

		annotation SummarizationSetBy = User

	column ISOWeek
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: ISOWeek

		annotation SummarizationSetBy = User

	column WeekdayNo
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: WeekdayNo

		annotation SummarizationSetBy = User

	column WeekdayName
		dataType: string
		summarizeBy: none
		sourceColumn: WeekdayName
		sortByColumn: WeekdayNo

		annotation SummarizationSetBy = User

	column WeekdayShort
		dataType: string
		summarizeBy: none
		sourceColumn: WeekdayShort
		sortByColumn: WeekdayNo

		annotation SummarizationSetBy = User

	column IsWeekend
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: IsWeekend

		annotation SummarizationSetBy = User

	column RetailEvent
		dataType: string
		summarizeBy: none
		sourceColumn: RetailEvent

		annotation SummarizationSetBy = User

	column FiscalYear
		dataType: string
		summarizeBy: none
		sourceColumn: FiscalYear

		annotation SummarizationSetBy = User

	column FiscalMonthNo
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: FiscalMonthNo

		annotation SummarizationSetBy = User

	column HasActuals
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: HasActuals

		annotation SummarizationSetBy = User

	partition Calendar = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Calendar.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"Year", Int64.Type}, {"Quarter", type text}, {"MonthNo", Int64.Type}, {"MonthName", type text}, {"MonthShort", type text}, {"YearMonth", Int64.Type}, {"MonthYear", type text}, {"DayOfMonth", Int64.Type}, {"ISOWeek", Int64.Type}, {"WeekdayNo", Int64.Type}, {"WeekdayName", type text}, {"WeekdayShort", type text}, {"IsWeekend", Int64.Type}, {"RetailEvent", type text}, {"FiscalYear", type text}, {"FiscalMonthNo", Int64.Type}, {"HasActuals", Int64.Type}}, "en-US")
				in
				    Typed

