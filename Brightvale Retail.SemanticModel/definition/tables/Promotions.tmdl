table Promotions

	column PromotionID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: PromotionID

		annotation SummarizationSetBy = User

	column PromotionName
		dataType: string
		summarizeBy: none
		sourceColumn: PromotionName

		annotation SummarizationSetBy = User

	column PromotionType
		dataType: string
		summarizeBy: none
		sourceColumn: PromotionType

		annotation SummarizationSetBy = User

	column StartDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: StartDate

		annotation SummarizationSetBy = User

	column EndDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: EndDate

		annotation SummarizationSetBy = User

	column DiscountPct
		dataType: double
		formatString: 0%
		summarizeBy: none
		sourceColumn: DiscountPct

		annotation SummarizationSetBy = User

	column Categories
		dataType: string
		summarizeBy: none
		sourceColumn: Categories

		annotation SummarizationSetBy = User

	column Channels
		dataType: string
		summarizeBy: none
		sourceColumn: Channels

		annotation SummarizationSetBy = User

	partition Promotions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Promotions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"PromotionID", Int64.Type}, {"PromotionName", type text}, {"PromotionType", type text}, {"StartDate", type date}, {"EndDate", type date}, {"DiscountPct", type number}, {"Categories", type text}, {"Channels", type text}}, "en-US")
				in
				    Typed

