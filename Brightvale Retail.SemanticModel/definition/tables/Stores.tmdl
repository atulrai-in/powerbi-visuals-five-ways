table Stores

	column StoreID
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: StoreID

		annotation SummarizationSetBy = User

	column StoreName
		dataType: string
		summarizeBy: none
		sourceColumn: StoreName

		annotation SummarizationSetBy = User

	column City
		dataType: string
		dataCategory: City
		summarizeBy: none
		sourceColumn: City

		annotation SummarizationSetBy = User

	column State
		dataType: string
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = User

	column Region
		dataType: string
		summarizeBy: none
		sourceColumn: Region

		annotation SummarizationSetBy = User

	column Format
		dataType: string
		summarizeBy: none
		sourceColumn: Format

		annotation SummarizationSetBy = User

	column OpenDate
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: OpenDate

		annotation SummarizationSetBy = User

	column SquareFeet
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: SquareFeet

		annotation SummarizationSetBy = User

	column Latitude
		dataType: double
		formatString: 0.0000
		dataCategory: Latitude
		summarizeBy: none
		sourceColumn: Latitude

		annotation SummarizationSetBy = User

	column Longitude
		dataType: double
		formatString: 0.0000
		dataCategory: Longitude
		summarizeBy: none
		sourceColumn: Longitude

		annotation SummarizationSetBy = User

	column StoreManager
		dataType: string
		summarizeBy: none
		sourceColumn: StoreManager

		annotation SummarizationSetBy = User

	partition Stores = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Stores.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"StoreID", Int64.Type}, {"StoreName", type text}, {"City", type text}, {"State", type text}, {"Region", type text}, {"Format", type text}, {"OpenDate", type date}, {"SquareFeet", Int64.Type}, {"Latitude", type number}, {"Longitude", type number}, {"StoreManager", type text}}, "en-US")
				in
				    Typed

