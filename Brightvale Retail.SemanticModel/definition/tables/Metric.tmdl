table Metric

	column Metric
		dataType: string
		summarizeBy: none
		sourceColumn: [Value1]
		sortByColumn: 'Metric Order'

		relatedColumnDetails
			groupByColumn: 'Metric Fields'

		annotation SummarizationSetBy = Automatic

	column 'Metric Fields'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: [Value2]
		sortByColumn: 'Metric Order'

		extendedProperty ParameterMetadata =
				{
				  "version": 3,
				  "kind": 2
				}

		annotation SummarizationSetBy = Automatic

	column 'Metric Order'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: sum
		sourceColumn: [Value3]

		annotation SummarizationSetBy = Automatic

	partition Metric = calculated
		mode: import
		source =
				{
				    ("Net Sales", NAMEOF('_Measures'[Net Sales]), 0),
				    ("YoY %", NAMEOF('_Measures'[YoY %]), 1),
				    ("LFL YoY %", NAMEOF('_Measures'[LFL YoY %]), 2),
				    ("Variance to Target %", NAMEOF('_Measures'[Variance to Target %]), 3),
				    ("Margin %", NAMEOF('_Measures'[Margin %]), 4)
				}

